{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@earendil-works/pi-coding-agent/node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "index.ts",
    "config-path.ts",
    "cache-diagnostics/**/*.ts",
    "context-cost/**/*.ts",
    "account-switch/**/*.ts",
    "telegram-notify/**/*.ts"
  ]
}
